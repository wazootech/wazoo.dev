{
  "version": "1.1.0",
  "canonical": {
    "primary": "#FF8C00",
    "lightBg": "#F7F2E8",
    "note": "DESIGN.md root frontmatter is canonical. The archived wazootech/brand repo lists #FF9800/#FAFAF9; those values are superseded."
  },
  "color": {
    "primitive": {
      "orange-500": "#FF8C00",
      "orange-300": "#FFB74D",
      "orange-600": "#F57C00",
      "amber": "#FFAA00",
      "violet": "#846CE4",
      "magenta": "#FF00FF",
      "cyan": "#00FFFF",
      "umber": "#4B4332",
      "void": "#040404",
      "surface": "#0F0F0F",
      "eggshell": "#F7F2E8",
      "ink": "#1F1B14",
      "gray-400": "#B0B0B1",
      "gray-500": "#7C7C7C",
      "white": "#FFFFFF",
      "zinc-700": "#3F3F46",
      "zinc-500": "#71717A"
    },
    "semantic": {
      "dark": {
        "bg": "void",
        "surface": "surface",
        "text": "gray-400",
        "textMuted": "gray-500",
        "heading": "white",
        "primary": "orange-500",
        "primaryHover": "orange-600",
        "border": "#111111",
        "borderSubtle": "#1A1A1A",
        "selection": "violet"
      },
      "light": {
        "bg": "eggshell",
        "surface": "white",
        "text": "zinc-700",
        "textMuted": "zinc-500",
        "heading": "ink",
        "primary": "orange-500",
        "primaryHover": "orange-600",
        "border": "#E5E7EB",
        "borderSubtle": "#F1F5F9",
        "selection": "violet"
      }
    }
  },
  "typography": {
    "fonts": {
      "body": "IBM Plex Mono",
      "heading": "Inter"
    },
    "scale": {
      "h1": "2.5rem",
      "h2": "1.5rem",
      "h3": "1.125rem",
      "body": "1.0625rem",
      "caption": "0.875rem"
    },
    "tracking": { "body": "-0.025em", "heading": "-0.02em" }
  },
  "spacing": ["0.25rem", "0.5rem", "0.75rem", "1rem", "1.5rem", "2rem", "3rem", "4rem"],
  "shape": {
    "radiusSm": "4px",
    "radius": "8px",
    "radiusMax": "12px",
    "borderWidth": "1px"
  },
  "motion": {
    "duration": { "fast": "0.2s", "normal": "0.3s", "slow": "0.6s" },
    "easing": {
      "standard": "ease",
      "overshoot": "cubic-bezier(0.68, -0.55, 0.27, 1.55)"
    },
    "quirks": ["quirk-highlight", "quirk-void", "quirk-breathe", "quirk-glitch"]
  }
}
